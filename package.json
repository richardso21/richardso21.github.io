		"@tailwindcss/postcss": "^4.1.11",
		"@types/node": "^24.6.0",
		"@types/three": "^0.172.0",
		"eslint": "^9.33.0",
		"eslint-config-prettier": "^9.1.2",
		"eslint-plugin-svelte": "^2.46.1",
		"globals": "^15.15.0",
		"husky": "^9.1.7",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
